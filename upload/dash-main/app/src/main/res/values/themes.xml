<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme.  Compose handles all theming at runtime
        via LibreTuneTheme, so this XML theme just needs to be a no-op
        Compose-side entry point.
    -->
    <style name="Theme.LibreTune" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>